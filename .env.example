# --------------------------------------------------------- #
# Telegram Guard Bot — Environment Variables Template
# --------------------------------------------------------- #
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git.
# --------------------------------------------------------- #

# ------- Telegram ------- #
BOT_TOKEN=

# Comma-separated list of Telegram user IDs who are bot admins
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=
LOG_LEVEL=INFO
TIMEZONE=Asia/Tashkent
WEB_ADMIN_KEY=

# ------- Firebase / Firestore ------- #
# All values are found in your Firebase project's Service Account JSON file.
# Go to: Firebase Console → Project Settings → Service accounts → Generate new private key

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=

# Paste the entire private key value including -----BEGIN/END PRIVATE KEY----- lines.
# Replace literal newlines with \n so the value fits on one line.
FIREBASE_PRIVATE_KEY=

FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# These three usually don't change — defaults are set in config.py
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

FIREBASE_CLIENT_X509_CERT_URL=

# ------- Rate limits (optional) ------- #
RATE_LIMIT_CALLBACK=5
RATE_LIMIT_CALLBACK_WINDOW=10
RATE_LIMIT_SETUP=3
RATE_LIMIT_SETUP_WINDOW=30
RATE_LIMIT_SUBSCRIPTION=5
RATE_LIMIT_SUBSCRIPTION_WINDOW=20
