# Telegram Bot Configuration
BOT_TOKEN=
BOT_USERNAME=

# Global Administrators (Single or comma-separated user IDs and usernames)
ADMIN_ID=
ADMIN_IDS=
ADMIN_USERNAME=
ADMIN_USERNAMES=

# Firebase / Firestore Credentials (Raw JSON string or Base64-encoded service account key)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=

# Web Service and Server Port
PORT=10000
WEB_ADMIN_KEY=

# Application Settings
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
DEBUG=false

# Cache and Rate Limiting
CACHE_TTL_GROUP_CONFIG=300
CACHE_TTL_MEMBER_STATUS=60
RATE_LIMIT_DEFAULT=2.0
RATE_LIMIT_SUBSCRIPTION=3.0
RATE_LIMIT_SUBSCRIPTION_WINDOW=5.0
